rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Definitions
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isServerTimestamp(field) { return field == request.time; }

    // 2. Validation Blueprints
    function isValidBusiness(data) {
      return data.keys().hasAll(['name', 'category', 'ownerName', 'email']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.category is string &&
             data.email is string && data.email.size() <= 255;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['businessId', 'name', 'phone']) &&
             data.businessId is string &&
             data.name is string && data.name.size() <= 100 &&
             data.phone is string && data.phone.size() <= 20;
    }

    function isValidLead(data) {
      return data.keys().hasAll(['businessId', 'name']) &&
             data.businessId is string &&
             data.name is string && data.name.size() <= 100;
    }

    function isValidReminder(data) {
      return data.keys().hasAll(['businessId', 'title', 'date']) &&
             data.businessId is string &&
             data.title is string && data.title.size() <= 100 &&
             data.date is timestamp;
    }

    // 3. Match Blocks
    match /businesses/{businessId} {
      allow get: if isOwner(businessId);
      allow create: if isOwner(businessId) && isValidBusiness(incoming());
      allow update: if isOwner(businessId) && isValidBusiness(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'ownerName', 'phone', 'address', 'description', 'workingHours', 'socialLinks'])
      );
      allow delete: if false; // Archive instead of delete for business profiles

      // Sub-collections: Customers, Leads, Reminders
      match /customers/{customerId} {
        allow list: if isOwner(businessId);
        allow get: if isOwner(businessId);
        allow create: if isOwner(businessId) && isValidCustomer(incoming()) && incoming().businessId == businessId;
        allow update: if isOwner(businessId) && isValidCustomer(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'address', 'type', 'lastInteraction', 'visitCount', 'totalSpent', 'sentiment', 'churnScore', 'notes', 'relationshipScore'])
        );
        allow delete: if isOwner(businessId);
      }

      match /leads/{leadId} {
        allow list: if isOwner(businessId);
        allow get: if isOwner(businessId);
        allow create: if isOwner(businessId) && isValidLead(incoming()) && incoming().businessId == businessId;
        allow update: if isOwner(businessId) && isValidLead(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'status', 'score', 'notes'])
        );
        allow delete: if isOwner(businessId);
      }

      match /reminders/{reminderId} {
        allow list: if isOwner(businessId);
        allow get: if isOwner(businessId);
        allow create: if isOwner(businessId) && isValidReminder(incoming()) && incoming().businessId == businessId;
        allow update: if isOwner(businessId) && isValidReminder(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'date', 'type', 'status'])
        );
        allow delete: if isOwner(businessId);
      }
    }
  }
}
